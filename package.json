{
  "name": "dsh-completion-chime",
  "version": "2.1.0",
  "description": "Rings a chime and pops a card when your turn finishes. Bring your own rings.",
  "license": "MIT",
  "author": "李桂宁",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/David-li-tao/dsh-completion-chime.git"
  },
  "homepage": "https://github.com/David-li-tao/dsh-completion-chime#readme",
  "bugs": {
    "url": "https://github.com/David-li-tao/dsh-completion-chime/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "chime.js",
    "cordis.patch.yml",
    "assets/*.wav",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "notification",
    "chime",
    "toast"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
